{
  "name": "logverifier",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:web": "bun --filter @logverifier/web dev",
    "build:web": "bun --filter @logverifier/web build",
    "lint": "bun --filter '*' lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v"
  }
}
