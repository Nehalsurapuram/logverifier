# Copy to .env and adjust. Docker Compose reads this file automatically because
# it sits next to docker-compose.yml; a local `npm start` picks it up too.
#
#   cp .env.example .env

# --- Service ----------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=observability-backend
HOST=0.0.0.0
PORT=4000
# Port the storefront is published on.
FRONTEND_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# Grace period for in-flight requests when the process is asked to stop.
SHUTDOWN_TIMEOUT_MS=10000

# --- Secrets ----------------------------------------------------------------
# Signs session tokens. REQUIRED when NODE_ENV=production, where it must also
# be at least 32 characters â€” the service refuses to start otherwise rather
# than fall back to a default anyone could read in this file.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Accepts the usual duration strings: 15m, 1h, 7d.
JWT_EXPIRES_IN=1h

# --- PostgreSQL -------------------------------------------------------------
# `localhost` is correct when you run the backend with npm. Compose overrides
# this to `postgres` for the container, because that is the service name on the
# compose network.
POSTGRES_HOST=localhost
# If you already run PostgreSQL on 5432, change this to a free port such as
# 5433. Compose publishes the container on whatever you set here, so the host
# tools and the test suite follow automatically; inside the network it stays 5432.
POSTGRES_PORT=5432
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability
POSTGRES_DB=observability
# --- Connection pool ---------------------------------------------------------
# Lower DB_POOL_MAX to make pool exhaustion reproducible: with max=1 any two
# concurrent requests queue, and /health reports waiting > 0.
DB_POOL_MAX=10
DB_POOL_MIN=0
# How long a request waits for a free connection before failing with a 503
# rather than hanging.
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Server-side and client-side query ceilings.
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=15000
# Statements at or above this duration are logged as slow.
DB_SLOW_QUERY_MS=500
# How often the background probe refreshes the reading /health serves.
DB_HEALTH_INTERVAL_MS=10000
# Identifies this service in pg_stat_activity.
# DB_APP_NAME=observability-backend

# Applies pending migrations at startup. Convenient for a demo; a real
# deployment runs `npm run db:migrate` as its own step so two replicas starting
# together cannot race each other.
DB_AUTO_MIGRATE=true

# Set this to point at a managed database; it overrides the POSTGRES_* values.
# DATABASE_URL=postgresql://user:password@host:5432/database

# --- Commerce ---------------------------------------------------------------
TAX_RATE_PERCENT=8.5
MAX_ORDER_ITEMS=20

# --- Failure and latency simulation -----------------------------------------
# The ONLY source of artificial latency in the service. Off by default; turn it
# on to give the observability stack something to detect.
SIMULATED_DELAY_ENABLED=false
SIMULATED_DELAY_MIN_MS=0
SIMULATED_DELAY_MAX_MS=0

# Share of payment attempts the mock provider declines at random, 0 to 1.
# Deterministic test cards work regardless of this setting â€” see the README.
PAYMENT_FAILURE_RATE=0

# --- Later phases (nothing reads these yet) ---------------------------------
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# GRAFANA_PORT=3001
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

