# Copy to .env and adjust. Docker Compose reads .env from the repo root:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
# The bun run infra:* scripts pick it up automatically.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=logverifier
POSTGRES_PASSWORD=logverifier
POSTGRES_DB=logverifier
POSTGRES_PORT=5432
DATABASE_URL=postgresql://logverifier:logverifier@localhost:5432/logverifier

# --- Observability ----------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_PORT=3100
# 3001, because the Next.js dashboard owns 3000.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Services (added in later phases) ---------------------------------------
API_PORT=4000
AI_PORT=4100

# --- LLM provider -----------------------------------------------------------
# Provider-specific code sits behind an adapter, so this can be swapped later.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
